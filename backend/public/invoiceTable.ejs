<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= invoiceConfig.invoiceTitle %> - <%= orderNumber %></title>
  <%
    const activeDesignTemplate=invoiceConfig.design?.templates?.find(item=>item.id===invoiceConfig.design.activeTemplateId)||invoiceConfig.design?.templates?.[0];
    const useCustomDesign=Boolean(invoiceConfig.design?.enabled&&activeDesignTemplate);
    const designPageSize=activeDesignTemplate?.pageSize||invoiceConfig.pageSize;
    const designOrientation=activeDesignTemplate?.orientation||"portrait";
    const pageDimensions={
      A4:{portrait:["210mm","297mm"],landscape:["297mm","210mm"]},
      A5:{portrait:["148mm","210mm"],landscape:["210mm","148mm"]},
      Letter:{portrait:["215.9mm","279.4mm"],landscape:["279.4mm","215.9mm"]}
    };
    const designDimensions=pageDimensions[designPageSize]?.[designOrientation]||pageDimensions.A4.portrait;
    const designWidth=designDimensions[0];
    const designHeight=designDimensions[1];
    const rawPrintMargins=activeDesignTemplate?.printMargins||{};
    const printMargin=value=>Math.max(0,Math.min(25,Number(value)||0));
    const designPrintMargins={top:printMargin(rawPrintMargins.top),right:printMargin(rawPrintMargins.right),bottom:printMargin(rawPrintMargins.bottom),left:printMargin(rawPrintMargins.left)};
  %>
  <style>
    @page { size: <%= useCustomDesign ? designPageSize+" "+designOrientation : invoiceConfig.pageSize %>; margin: <%= useCustomDesign ? "0" : "8mm" %>; }
    *{box-sizing:border-box}
    html,body{margin:0;padding:0}
    body{width:100%;font-family:Arial,Helvetica,sans-serif;color:#111827;background:#fff;font-size:11px;line-height:1.35}
    .invoice{width:100%;max-width:194mm;margin:0 auto;border:1.5px solid <%= invoiceConfig.accentColor %>}
    table{width:100%;border-collapse:collapse;table-layout:fixed}
    th,td{border:1px solid <%= invoiceConfig.accentColor %>;padding:5px 6px;vertical-align:top}
    th{font-weight:800}
    .header{text-align:center;padding:8px 10px}
    .organization-logo{display:block;width:auto;max-width:150px;max-height:64px;object-fit:contain;margin:0 auto 6px}
    .header-title{font-size:12px;font-weight:800}
    .company-name{font-size:22px;font-weight:900;margin:2px 0;letter-spacing:.15px}
    .gst{font-size:12px;font-weight:800}
    .contact-row{display:flex;justify-content:space-between;gap:12px;margin-top:7px;font-size:10px}
    .address{flex:1;text-align:center}
    .doc-title{background:#f3f4f6;text-align:center;font-size:13px;font-weight:900;padding:6px;letter-spacing:.6px}
    .section-label{background:#f3f4f6;font-weight:800;text-transform:uppercase}
    .label{color:#374151;font-weight:700}
    .value{font-weight:800}
    .small{font-size:10px}
    .center{text-align:center}
    .right{text-align:right}
    .items th{background:#f3f4f6;text-align:center;font-size:9px;vertical-align:middle}
    .items td{height:27px;font-size:10px}
    .items .desc{text-align:left}
    .summary td{font-size:10px}
    .words{text-align:center;font-weight:700;min-height:40px}
    .bank{line-height:1.55}
    .terms{line-height:1.5}
    .total{font-size:12px;font-weight:900}
    .grand{font-size:14px;font-weight:900}
    .web-credit{padding:4px 6px;font-size:8px;color:#6b7280}
    .nowrap{white-space:nowrap}
    .design-sheet{position:relative;width:<%= designWidth %>;height:<%= designHeight %>;margin:0 auto;overflow:hidden;background:#fff;print-color-adjust:exact;-webkit-print-color-adjust:exact}
    .design-background{position:absolute;inset:0;z-index:0;width:100%;height:100%;border:0;object-fit:fill}
    .design-background-frame{position:absolute;inset:0;z-index:0;width:100%;height:100%;border:0;pointer-events:none;background:#fff}
    .design-content-area{position:absolute;z-index:1;top:<%= designPrintMargins.top %>mm;right:<%= designPrintMargins.right %>mm;bottom:<%= designPrintMargins.bottom %>mm;left:<%= designPrintMargins.left %>mm;}
    .design-block{position:absolute;z-index:1;overflow:hidden;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.25}
    .design-block .field-label{font-size:.8em;color:#64748b;font-weight:600}
    .design-items{width:100%;min-height:100%;overflow:visible}
    .design-items table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:8px}
    .design-items th,.design-items td{border:1px solid #9aa8b8;padding:4px;vertical-align:top;overflow-wrap:anywhere}
    .design-items th{height:8mm;background:#edf2f7;text-align:center;font-weight:800}
    .design-items td{min-height:9mm;height:auto}
    .design-cell-text{display:block;overflow:visible;line-height:1.2;overflow-wrap:anywhere;white-space:pre-wrap}
    .design-items thead{display:table-header-group}
    .design-items tr{height:9mm;break-inside:avoid;page-break-inside:avoid}
    .design-page-number{position:absolute;right:6%;top:1%;z-index:5;font-size:8px;color:#64748b}
    .design-totals{width:100%;font-size:9px}
    .design-totals div{display:flex;justify-content:space-between;gap:8px;padding:3px 1px;border-bottom:1px solid #e5eaf0}
    .design-totals .grand{font-size:12px;font-weight:900;border-top:1.5px solid #475569}
    @media print{body{print-color-adjust:exact;-webkit-print-color-adjust:exact}.invoice{max-width:none}.design-sheet{margin:0;break-after:page;page-break-after:always}.design-sheet.is-last-page{break-after:auto;page-break-after:auto}}
    @media screen{.design-sheet{margin-bottom:8mm;box-shadow:0 0 0 1px #d8e0e9}.design-sheet.is-last-page{margin-bottom:0}}

  </style>
</head>
<body>
<% if(useCustomDesign){ 
  const activeBlocks=(activeDesignTemplate.blocks||[]).filter(block=>block.visible!==false);
  const designPages=typeof invoicePages!=="undefined"&&Array.isArray(invoicePages)&&invoicePages.length?invoicePages:[{pageNumber:1,totalPages:1,blocks:activeBlocks,rows:(subOrders||[]).map((item,index)=>({item,itemNumber:index+1}))}];
  const designColumns=(invoiceConfig.itemColumns||[]).slice().sort((a,b)=>(a.order||0)-(b.order||0)).filter(column=>column.visible!==false);
  const designValues={
    company_name:profileCompanyName,company_address:profileCompanyAddress,company_gstin:profileGstNumber,
    company_phone:[profilePhoneNumber1,profilePhoneNumber2].filter(Boolean).join(" / "),company_email:profileEmailAddress,
    customer_name:clientCompanyName,customer_address:clientAddress,customer_phone:clientPhoneNumber,customer_gstin:clientGstNumber,customer_state:clientState,
    invoice_title:invoiceConfig.invoiceTitle,invoice_no:orderNumber,invoice_date:createdAt,due_date:dueDate,challan_no:clientChallanNumber,
    payment_terms:paymentTerm?("Net "+paymentTerm+" days"):"",eway_bill:ewayBillNo,
    subtotal:orderSubTotal,discount:orderDiscountAmount,taxable_value:orderTotalCost,cgst:orderTaxAmount,
    sgst:orderTaxAmount,igst:orderIgstTaxAmount,round_off:orderFinalRevenueRoundOff,
    grand_total:orderFinalRevenueAfterRoundOff,amount_paid:orderPaidAmount,balance_due:dueAmount,
    amount_words:orderFinalRevenueInWords,
    bank_details:[profileBankName,profileAccountNo,profileBranchName,profileIfsc].filter(Boolean).join(" · "),
    terms:"Goods once sold will not be taken back or replaced. Any complaint should be made within 7 days. Subject to Surat jurisdiction.",
    signature:"For, "+profileCompanyName+" · Authorised Signatory"
  };
  const itemValue=(item,column)=>{
    const unit=item.qtyUnit||"PCS";
    const enteredQty=unit==="MTR"?Number(item.MTR||0):Number(item.quantity||0);
    const shortQty=Math.max(0,Number(item.shortPcs||0));
    const qty=Math.max(0,enteredQty-shortQty);
    const amount=qty*Number(item.unitPrice||0);
    const taxable=amount*(1-Number(orderDisRate||0)/100);
    switch(column.key){
      case "sr":return item._index;
      case "description":return item.orderName||"";
      case "designNumber":return item.designNumber||"";
      case "hsnCode":return item.hsnCode||"";
      case "quantity":return unit==="MTR"?(item.quantity||0):qty;
      case "qtyUnit":return unit;
      case "cut":return item.cut||0;
      case "MTR":return unit==="MTR"?qty:(item.MTR||0);
      case "shortPcs":return shortQty;
      case "unitPrice":return Number(item.unitPrice||0).toFixed(2);
      case "amount":return Number(amount||0).toFixed(2);
      case "discount":return Number(orderDisRate||0).toFixed(2)+"%";
      case "taxable":return Number(taxable||0).toFixed(2);
      default:return item[column.key]??"";
    }
  };
%>
  <% designPages.forEach((page,pageIndex)=>{ %>
  <div class="design-sheet <%= pageIndex===designPages.length-1?'is-last-page':'' %>">
    <% if(activeDesignTemplate.background?.url&&activeDesignTemplate.background.visible!==false){
      const backgroundUrl=activeDesignTemplate.background.url.startsWith("http")?activeDesignTemplate.background.url:(publicUploadBaseUrl||"")+activeDesignTemplate.background.url;
    %>
      <% if(activeDesignTemplate.background.type==="pdf"){ %>
        <iframe class="design-background-frame" src="<%= backgroundUrl %>#toolbar=0&navpanes=0&scrollbar=0" title="Imported invoice background"></iframe>
      <% }else{ %>
        <img class="design-background" src="<%= backgroundUrl %>" alt="Imported invoice background">
      <% } %>
    <% } %>
    <div class="design-content-area">
    <% page.blocks.forEach(block=>{ %>
      <div class="design-block" style="left:<%= block.x %>%;top:<%= block.y %>%;width:<%= block.w %>%;height:<%= block.h %>%;overflow:<%= block.type==="items_table"||block.type==="totals"?"visible":"hidden" %>;font-size:<%= block.fontSize %>px;font-weight:<%= block.bold?700:400 %>;font-style:<%= block.italic?"italic":"normal" %>;font-family:<%= block.fontFamily||"Arial" %>;text-align:<%= block.align %>;color:<%= block.color %>;background-color:<%= block.backgroundColor||"transparent" %>;border:<%= Number(block.borderWidth||0) %>px solid <%= block.borderColor||"#d8e0e9" %>;border-radius:<%= Number(block.borderRadius||0) %>px;padding:<%= Number(block.padding||0) %>px;opacity:<%= Number(block.opacity||1) %>">
        <% if(block.type==="shape"){ %>
        <% }else if(block.type==="image"){ %><img src="<%= block.imageUrl %>" alt="<%= block.label||"Imported image" %>" style="display:block;width:100%;height:100%;object-fit:<%= block.imageFit||"contain" %>">
        <% }else if(block.type==="text"){ %><%= block.text||block.label %>
        <% }else if(block.type==="divider"){ %><div style="width:100%;border-top:1px solid currentColor;margin-top:3px"></div>
        <% }else if(block.type==="logo"){ %>
          <% if(profileLogoUrl){ %><img src="<%= profileLogoUrl %>" alt="Business logo" style="width:100%;height:100%;object-fit:contain"><% } %>
        <% }else if(block.type==="field"){ %>
          <% const displayValue=designValues[block.fieldKey]??""; %>
          <% if(block.label&&block.showLabel!==false){ %><span class="field-label"><%= block.label %>: </span><% } %><%= displayValue %>
        <% }else if(block.type==="items_table"){ %>
          <% const blockColumns=Array.isArray(block.columns)&&block.columns.length?block.columns.filter(column=>column.visible!==false):designColumns; %>
          <% const tableColumns=blockColumns.length?blockColumns:designColumns; %>
          <div class="design-items" style="font-size:<%= block.fontSize %>px;color:<%= block.color %>">
            <table style="font-size:<%= Number(block.fontSize||8) %>px">
              <colgroup><% tableColumns.forEach(column=>{ %><col style="width:<%= Number(column.width||8) %>%"><% }) %></colgroup>
              <thead><tr><% tableColumns.forEach(column=>{ %><th style="background:<%= block.tableHeaderBackground||"#edf2f7" %>;color:<%= block.tableHeaderColor||"#172335" %>;border-color:<%= block.tableBorderColor||"#b8c4d1" %>;border-width:<%= Number(block.tableBorderWidth??1) %>px;padding:<%= Number(block.tableCellPadding??4) %>px"><span class="design-cell-text"><%= column.label %></span></th><% }) %></tr></thead>
              <tbody>
                <% (page.rows||[]).forEach((entry,rowIndex)=>{ const row={...entry.item,_index:entry.itemNumber}; const rowBackground=block.alternateRows!==false&&(Number(entry.itemNumber||rowIndex+1)-1)%2===1?(block.tableAlternateRowBackground||"#f7f9fc"):(block.tableRowBackground||"#ffffff"); %>
                  <tr style="height:<%= Number(entry.rowHeightMm||9).toFixed(2) %>mm"><% tableColumns.forEach(column=>{ %><td style="background:<%= rowBackground %>;border-color:<%= block.tableBorderColor||"#b8c4d1" %>;border-width:<%= Number(block.tableBorderWidth??1) %>px;padding:<%= Number(block.tableCellPadding??4) %>px"><span class="design-cell-text"><%= itemValue(row,column) %></span></td><% }) %></tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% }else if(block.type==="totals"){ %>
          <div class="design-totals">
            <div><span>Subtotal</span><b>₹ <%= Number(orderSubTotal||0).toFixed(2) %></b></div>
            <div><span>Discount</span><b>− ₹ <%= Number(orderDiscountAmount||0).toFixed(2) %></b></div>
            <div><span>Taxable value</span><b>₹ <%= Number(orderTotalCost||0).toFixed(2) %></b></div>
            <% if(Number(orderIgstTax||0)>0){ %><div><span>IGST</span><b>₹ <%= Number(orderIgstTaxAmount||0).toFixed(2) %></b></div><% }else{ %>
              <div><span>CGST</span><b>₹ <%= Number(orderTaxAmount||0).toFixed(2) %></b></div>
              <div><span>SGST</span><b>₹ <%= Number(orderTaxAmount||0).toFixed(2) %></b></div>
            <% } %>
            <div><span>Round off</span><b>₹ <%= Number(orderFinalRevenueRoundOff||0).toFixed(2) %></b></div>
            <div class="grand"><span>Invoice total</span><b>₹ <%= Number(orderFinalRevenueAfterRoundOff||0).toFixed(2) %></b></div>
            <div><span>Paid</span><b>₹ <%= Number(orderPaidAmount||0).toFixed(2) %></b></div>
            <div><span>Due</span><b>₹ <%= Number(dueAmount||0).toFixed(2) %></b></div>
          </div>
        <% } %>
      </div>
    <% }) %>
    </div>
    <% if(page.totalPages>1){ %><div class="design-page-number">Page <%= page.pageNumber %> of <%= page.totalPages %></div><% } %>
  </div>
  <% }) %>
<% }else{ %>
<%
  const defaults=[
    {key:"sr",label:"Sr",visible:true,order:0,width:5},
    {key:"description",label:"Desc.",visible:true,order:1,width:17},
    {key:"designNumber",label:"Design No.",visible:true,order:2,width:13},
    {key:"hsnCode",label:"HSN",visible:true,order:3,width:9},
    {key:"quantity",label:"Qty",visible:true,order:4,width:8},
    {key:"qtyUnit",label:"Unit",visible:true,order:5,width:5},
    {key:"cut",label:"Cut",visible:true,order:6,width:7},
    {key:"MTR",label:"MTR",visible:true,order:7,width:7},
    {key:"unitPrice",label:"Rate",visible:true,order:8,width:8},
    {key:"amount",label:"Amount",visible:true,order:9,width:8},
    {key:"discount",label:"Disc.",visible:true,order:10,width:7},
    {key:"taxable",label:"Taxable",visible:true,order:11,width:12}
  ];
  const itemColumns=(invoiceConfig.itemColumns||defaults).slice().sort((a,b)=>(a.order||0)-(b.order||0)).filter(column=>column.visible!==false);
  const itemCellClass=key=>["sr","designNumber","hsnCode","quantity","qtyUnit","cut","MTR"].includes(key)?"center":["unitPrice","amount","discount","taxable"].includes(key)?"right":"desc";
%>
<div class="invoice">

  <div class="header">
    <% if(profileLogoUrl) { %><img class="organization-logo" src="<%= profileLogoUrl %>" alt="Organization logo"><% } %>
    <% if(invoiceConfig.header.showHeaderTitle){ %><div class="header-title"><%= profileHeaderTitle %></div><% } %>
    <% if(invoiceConfig.header.showCompanyName){ %><div class="company-name"><%= profileCompanyName %></div><% } %>
    <% if(invoiceConfig.header.showGST){ %><div class="gst">GSTIN: <%= profileGstNumber %></div><% } %>
    <% if(invoiceConfig.header.showPhones || invoiceConfig.header.showAddress){ %>
      <div class="contact-row">
        <% if(invoiceConfig.header.showPhones){ %><span class="nowrap">+91-<%= profilePhoneNumber1 %></span><% } else { %><span></span><% } %>
        <% if(invoiceConfig.header.showAddress){ %><span class="address"><%= profileCompanyAddress %></span><% } %>
        <% if(invoiceConfig.header.showPhones){ %><span class="nowrap">+91-<%= profilePhoneNumber2 %></span><% } else { %><span></span><% } %>
      </div>
    <% } %>
    <% if(profileEmailAddress || profileWebsite) { %>
      <div class="contact-extra">
        <% if(profileEmailAddress) { %><span>Email: <%= profileEmailAddress %></span><% } %>
        <% if(profileWebsite) { %><span><%= profileWebsite %></span><% } %>
      </div>
    <% } %>
  </div>

  <div class="doc-title"># <%= invoiceConfig.invoiceTitle %> #</div>

  <table>
    <tr>
      <td colspan="5" class="section-label">Receiver's Details</td>
      <td colspan="7" class="section-label">Invoice Details</td>
    </tr>
    <tr>
      <td colspan="5">
        <% if(invoiceConfig.receiver.showName){ %><span class="label">Name:</span> <span class="value"><%= clientCompanyName %></span><br><% } %>
        <% if(invoiceConfig.receiver.showAddress){ %><span class="label">Address:</span> <%= clientAddress %><br><% } %>
        <% if(invoiceConfig.receiver.showMobile){ %><span class="label">Mobile:</span> +91 <%= clientPhoneNumber %><br><% } %>
        <% if(invoiceConfig.receiver.showState){ %><span class="label">State:</span> <%= clientState %><br><% } %>
        <% if(invoiceConfig.receiver.showGSTIN){ %><span class="label">GSTIN:</span> <%= clientGstNumber %><% } %>
      </td>
      <td colspan="7">
        <% if(invoiceConfig.invoiceDetails.showChallan){ %><span class="label">Challan No.:</span> <%= clientChallanNumber %><br><% } %>
        <% if(invoiceConfig.invoiceDetails.showInvoiceNo){ %><span class="label">Invoice No.:</span> <%= orderNumber %><br><% } %>
        <% if(invoiceConfig.invoiceDetails.showInvoiceDate){ %><span class="label">Invoice Date:</span> <%= createdAt %><br><% } %>
        <% if(invoiceConfig.invoiceDetails.showDueDate){ %><span class="label">Due Date:</span> <%= dueDate %><br><% } %>
        <% if(invoiceConfig.invoiceDetails.showPaymentTerms){ %><span class="label">Payment Terms:</span> Net <%= paymentTerm %> Days<br><% } %>
        <% if(invoiceConfig.invoiceDetails.showEwayBill){ %><span class="label">E-Way Bill:</span> <%= ewayBillNo %><% } %>
      </td>
    </tr>
  </table>

  <table class="items">
    <colgroup>
      <% itemColumns.forEach(column=>{ %><col style="width:<%= Number(column.width||8) %>%"><% }) %>
    </colgroup>
    <thead>
      <tr>
        <% itemColumns.forEach(column=>{ %><th><%= column.label %></th><% }) %>
      </tr>
    </thead>
    <tbody>
      <% for(let i=0;i<subOrders.length;i++){
        const item=subOrders[i];
        const unit=item.qtyUnit||"PCS";
        const enteredQty=unit==="MTR"?Number(item.MTR||0):Number(item.quantity||0);
        const shortQty=Math.max(0,Number(item.shortPcs||0));
        // Use the exact billable quantity rule from the invoice financial model.
        const qty=Math.max(0,enteredQty-shortQty);
        const amount=Number(qty||0)*Number(item.unitPrice||0);
        const taxable=amount*(1-Number(orderDisRate||0)/100);
      %>
        <tr>
          <% itemColumns.forEach(column=>{
            let value="";
            switch(column.key){
              case "sr": value=i+1; break;
              case "description": value=item.orderName||""; break;
              case "designNumber": value=item.designNumber||""; break;
              case "hsnCode": value=item.hsnCode||""; break;
              case "quantity": value=unit==="MTR"?(item.quantity||0):qty; break;
              case "qtyUnit": value=unit; break;
              case "cut": value=item.cut||0; break;
              case "MTR": value=unit==="MTR"?qty:(item.MTR||0); break;
              case "shortPcs": value=shortQty; break;
              case "unitPrice": value=Number(item.unitPrice||0).toFixed(2); break;
              case "amount": value=Number(amount||0).toFixed(2); break;
              case "discount": value=Number(orderDisRate||0).toFixed(2)+"%"; break;
              case "taxable": value=Number(taxable||0).toFixed(2); break;
            }
          %><td class="<%= itemCellClass(column.key) %>"><%= value %></td><% }) %>
        </tr>
      <% } %>
      <% for(let i=subOrders.length;i<10;i++){ %>
        <tr><% itemColumns.forEach(()=>{ %><td>&nbsp;</td><% }) %></tr>
      <% } %>
      <% if(!itemColumns.length){ %><tr><td>No printable item columns are selected.</td></tr><% } %>
    </tbody>
  </table>

  <table class="summary">
    <tr>
      <td colspan="9" class="words">
        <div>Amount (in words)</div>
        <div><%= orderFinalRevenueInWords %></div>
      </td>
      <td colspan="2"><b>Total</b></td>
      <td class="right"><b><%= orderSubTotal %></b></td>
    </tr>

    <tr>
      <td colspan="9" rowspan="2"></td>
      <td colspan="2"><% if(invoiceConfig.summary.showDiscount){ %>Discount (<%= orderDisRate %>%)<% } %></td>
      <td class="right"><% if(invoiceConfig.summary.showDiscount){ %><%= orderDiscountAmount %><% } %></td>
    </tr>
    <tr><td colspan="2" class="total">Taxable Value</td><td class="right total"><%= orderTotalCost %></td></tr>

    <tr>
      <td colspan="9" rowspan="6" class="bank">
        <% if(invoiceConfig.summary.showBankDetails){ %>
          <b>Supplier &amp; Bank Details</b><br>
          GSTIN: <%= profileGstNumber %><br>
          PAN: <%= profilePanNumber %><br>
          Bank Name: <%= profileBankName %><br>
          Account No.: <%= profileAccountNo %><br>
          Branch Name: <%= profileBranchName %><br>
          IFSC: <%= profileIfsc %>
        <% } %>
      </td>
      <td colspan="2"><% if(invoiceConfig.summary.showTax){ %>CGST (<%= orderTax %>%)<% } %></td>
      <td class="right"><% if(invoiceConfig.summary.showTax){ %><%= orderTaxAmount %><% } %></td>
    </tr>

    <tr><td colspan="2"><% if(invoiceConfig.summary.showTax){ %>SGST (<%= orderTax %>%)<% } %></td><td class="right"><% if(invoiceConfig.summary.showTax){ %><%= orderTaxAmount %><% } %></td></tr>
    <tr><td colspan="2"><% if(invoiceConfig.summary.showTax){ %>IGST (<%= orderIgstTax %>%)<% } %></td><td class="right"><% if(invoiceConfig.summary.showTax){ %><%= orderIgstTaxAmount %><% } %></td></tr>

    <tr><td colspan="2">Net Amount</td><td class="right"><%= orderFinalRevenue %></td></tr>

    <tr><td colspan="2"><% if(invoiceConfig.summary.showRoundOff){ %>Round Off (+/-)<% } %></td><td class="right"><% if(invoiceConfig.summary.showRoundOff){ %><%= orderFinalRevenueRoundOff %><% } %></td></tr>

    <tr><td colspan="2" class="grand">Invoice Total</td><td class="right grand"><%= orderFinalRevenueAfterRoundOff %></td></tr>
  </table>

  <% if(invoiceConfig.summary.showTerms){ %>
  <table>
    <tr>
      <td colspan="9" class="terms">
        <b>TERMS &amp; CONDITIONS</b><br>
        SUBJECT TO SURAT JURISDICTION E.&amp;O.E.<br>
        Goods once sold will not be taken back or replaced.<br>
        Any complaint of goods should be made within 7 days.<br>
        Interest @ 4% per month will be charged on the bill.<br>
        Receiver's Sign. ______________________________
      </td>
      <td colspan="3" class="center">
        For, <%= profileCompanyName %><br><br><br>
        Authorised Signatory<br>
