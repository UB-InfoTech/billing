<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Invoice</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        crossorigin="anonymous">
    <style>
        html {
            display: table;
            margin: auto;
            font-size: 105%;
        }

        body {
            size: 7vmin 9.25vmin;
            width: 210mm;
            vertical-align: middle;
        }

        table th {
            padding: 2px !important;
            font-size: small;
        }

        table td {
            padding: 5px !important;
            font-size: smaller;
        }

        .center-table-body {
            height: 30px !important;
            /* border: 1px solid red !important; */
        }

        .center-table-body:nth-last-child(1) {
            height: max-content !important;
        }

        /* margin: 0 !important; */
        /* margin: initial !important; */
        /* body {
        } */

        /* Hide headers and footers (if you're adding them via HTML) */
        /* margin: 0; */
        /* Optional: remove background images/colors */
        @media print {
            @page {
                size: A4;
            }

            header,
            footer {
                display: none !important;
            }
            * {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            background: none !important;
            }
        }
    </style>

    <!-- <script>
        const rowHeight = 270 / subOrders.length;
    </script> -->
</head>

<body contenteditable="true">
    <table class="table table-bordered border-black m-0">
        <thead>
            <tr>
                <th colspan="12">
                    <div class="d-flex flex-column text-center">
                        <span class="fw-bold">
                            <%= profileHeaderTitle %>
                        </span>
                        <span class="fw-bolder fs-3">
                            <%= profileCompanyName %>
                        </span>
                        <span class="fw-bold">
                            GSTIN: <%= profileGstNumber %><br>
                        </span>

                        <div class="d-flex justify-content-between align-items-end mb-1">
                            <span>+91-<%= profilePhoneNumber1 %></span>
                            <span style="max-width: 500px; line-height: 1.2;">
                                <%= profileCompanyAddress %>
                            </span>
                            <span>+91-<%= profilePhoneNumber2 %></span>
                        </div>
                    </div>
                </th>
            </tr>
            <tr>
                <th colspan="12" class="text-center"># TAX INVOICE #</th>
            </tr>
        </thead>

        <tbody>
            <tr>
                <td colspan="5">Receiver's Details</td>
                <td colspan="7">Invoice Details</td>
            </tr>
            <tr>
                <td colspan="5" style="width: 162px;">
                    Name: <%= clientCompanyName %><br>
                        <span style="display: flex;line-height: 1.3;">Address: <%= clientAddress %></span>
                        Mobile: +91 <%= clientPhoneNumber %><br>
                            State: <%= clientState %><br>
                                GSTIN: <%= clientGstNumber %><br>
                </td>
                <td colspan="7">
                    Chalan No.: <%= clientChallanNumber %><br>
                        Invoice No: <%= orderNumber %><br>
                            Invoice Date: <%= createdAt %><br>
                                Due Date: <%= dueDate %><br>
                                    Payment Terms: Net <%= paymentTerm %> Days<br>
                                    Eway Bill: <%= ewayBillNo %>
                </td>
            </tr>

            <tr>
                <td colspan="1" class="text-center fw-bold">Sr</td>
                <td colspan="1" class="fw-bold">Desc.</td>
                <td colspan="1" class="text-center fw-bold">Design No.</td>
                <td colspan="1" class="text-center border-0 fw-bold">HSN</td>
                <td colspan="1" class="text-center fw-bold">Qty</td>
                <td colspan="1" class="border-0"></td>
                <td colspan="1" class="text-center border-start-0 border-end-0 fw-bold">Cut</td>
                <td colspan="1" class="border-0"></td>
                <td colspan="1" class="text-center fw-bold">MTR</td>
                <td colspan="1" class="text-center fw-bold">Qty Unit</td>
                <td colspan="1" class="text-center fw-bold">Rate</td>
                <td colspan="1" class="text-center fw-bold">Amount</td>
            </tr>
        </tbody>
        <tbody style="height: 350px !important;">

            <% for (let i=0; i < subOrders.length; i++) { %>
                <tr style="border: 0;" class="center-table-body">
                    <td colspan="1" class="text-center">
                        <%= i + 1 %>
                    </td>
                    <td colspan="1">
                        <%= subOrders[i].orderName %>
                    </td>
                    <td colspan="1" class="text-center">
                        <%= subOrders[i].designNumber %>
                    </td>
                    <td colspan="1" class="text-center border-0">
                        <%= subOrders[i].hsnCode %>
                    </td>
                    <td colspan="1" class="text-center">
                        <%= subOrders[i].quantity %>
                    </td>
                    <td colspan="1" class="border-0"></td>
                    <td colspan="1" class="text-center border-end-0 border-start-0">
                        <%= subOrders[i].cut %>
                    </td>
                    <td colspan="1" class="border-0"></td>
                    <td colspan="1" class="text-center">
                        <%= subOrders[i].MTR %>
                    </td>
                    <td colspan="1" class="text-center">
                        <%= subOrders[i].qtyUnit %>
                    </td>
                    <td colspan="1" class="text-center">
                        <%= subOrders[i].unitPrice %>
                    </td>
                    <td colspan="1" class="text-center">
                        <% if (subOrders[i].qtyUnit==="MTR" ) { %>
                            <%= (subOrders[i].MTR * subOrders[i].unitPrice) %>
                                <% } else { %>
                                    <%= (subOrders[i].quantity * subOrders[i].unitPrice) %>
                                        <% } %>
                                            <!-- <%= subOrders[i].quantity * subOrders[i].unitPrice %> -->
                    </td>
                </tr>
                <% } %>
        </tbody>

        <tbody>

            <tr>
                <td></td>
                <td colspan="10" class="fw-bold">Total</td>
                <td class="fw-bold">
                    <%= orderSubTotal %>
                </td>
            </tr>

            <tr>
                <td colspan="9" class="text-center">Amount (in words)</td>
                <td colspan="2">Dis (<%= orderDisRate %> %)</td>
                <td>
                    <%= orderDiscountAmount %>
                </td>
            </tr>

            <tr>
                <td rowspan="2" colspan="9" class="text-center align-content-center">
                    <%= orderFinalRevenueInWords %>
                </td>
                <!-- <td colspan="2">Short (<%= orderShortPcs %> Pcs.)</td>
                <td>
                    <%= orderShortPcsAmount %>
                </td> -->
            </tr>

            <tr>
                <td colspan="2" class="fw-bold">Taxable Value</td>
                <td class="fw-bold">
                    <%= orderTotalCost %>
                </td>
            </tr>

            <tr>
                <td rowspan="6" colspan="9">
                    GSTIN: <%= profileGstNumber %><br>
                        PAN: <%= profilePanNumber %><br>
                            Bank Name: <%= profileBankName %><br>
                                Account No: <%= profileAccountNo %><br>
                                    Branch Name: <%= profileBranchName %><br>
                                        IFSC: <%= profileIfsc %><br>
                </td>
                <td colspan="2">CGST (<%= orderTax %> %)</td>
                <td>
                    <%= orderTaxAmount %>
                </td>
            </tr>

            <tr>
                <td colspan="2">SGST (<%= orderTax %> %)</td>
                <td>
                    <%= orderTaxAmount %>
                </td>
            </tr>

            <tr>
                <td colspan="2">IGST (<%= orderIgstTax %> %)</td>
                <td>
                    <%= orderIgstTaxAmount %>
                </td>
            </tr>

            <tr>
                <td colspan="2">Net Amount</td>
                <td>
                    <%= orderFinalRevenue %>
                </td>
            </tr>
            <tr>
                <td colspan="2">Round Off(+/-)</td>
                <td>
                    <%= orderFinalRevenueRoundOff %>
                </td>
            </tr>
            <tr>
                <td colspan="2" class="fw-bolder">Invoice Total</td>
                <td class="fw-bolder">
                    <%= orderFinalRevenueAfterRoundOff %>
                </td>
            </tr>

        </tbody>

        <tfoot>
            <tr>
                <td colspan="9">
                    TERM & CONDITION<br>
                    SUBJECT TO SURAT JURISDICTION E.&O.E.<br>
                    Goods once sold will not be taken back or replaced.<br>
                    Any complaint of goods should be made within 7 days.<br>
                    Interest @ 4% per month will be charged on the bill.<br>
                    Receiver's Sign. ___________________
                </td>
                <td colspan="3" class="text-center">
                    For, <%= profileCompanyName %><br><br><br>
                        Authorised Sign<br>
                        ____________________
                </td>
            </tr>
        </tfoot>
    </table>

    <span style="font-size: x-small !important;">
        Web-Application by Bhanderi Info Tech (+91-91091-95695)
    </span>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        crossorigin="anonymous"></script>
</body>

</html>